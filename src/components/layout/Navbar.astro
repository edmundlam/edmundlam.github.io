---
import { PAGES } from "../../config";

const currentPath = Astro.url.pathname;

const navLinks = Object.entries(PAGES)
    .filter(([, config]) => config.isActive && config.href)
    .map(([, config]) => ({
        href: config.href!,
        label: config.navTitle ?? config.title,
    }));
---

<nav class="navbar">
    <ul class="nav-links">
        {navLinks.map((link) => (
            <li>
                <a
                    href={link.href}
                    class={`nav-link ${
                        currentPath === link.href ||
                        (link.href !== "/" &&
                            currentPath.startsWith(link.href))
                            ? "active"
                            : "inactive"
                    }`}
                >
                    {link.label}
                    <span class="nav-link-line" />
                </a>
            </li>
        ))}
    </ul>
</nav>
